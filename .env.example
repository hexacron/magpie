# Magpie configuration. Copy to .env and edit.
# Every setting is optional; the value shown is the built-in default.

# --- storage ---------------------------------------------------------
# Root for capture packages (<data_dir>/captures) and the index (<data_dir>/index.db).
MAGPIE_DATA_DIR=./data

# --- server ----------------------------------------------------------
# Bind address. Use 0.0.0.0 in a container, 127.0.0.1 on a shared host.
MAGPIE_HOST=127.0.0.1
MAGPIE_PORT=8099
# Set when mounted under a subpath of a reverse proxy, e.g. /magpie (no trailing slash).
MAGPIE_BASE_PATH=
# Title shown in the web UI.
MAGPIE_SITE_NAME=Magpie

# --- auth ------------------------------------------------------------
# Gates every mutating route (capture, meta edits, delete, reindex).
# Unset means write routes are OPEN. Always set this on a reachable instance.
MAGPIE_AUTH_TOKEN=
# 1 = anyone may browse/read captures; 0 = reads also require the token.
MAGPIE_PUBLIC_READ=1
# Honour X-Forwarded-For / X-Forwarded-Proto. Only enable behind a proxy you control.
MAGPIE_TRUST_PROXY=0

# --- sources ---------------------------------------------------------
# Comma-separated subset of: syndication, fxtwitter, vxtwitter, x_page.
MAGPIE_SOURCES=syndication,fxtwitter,vxtwitter,x_page
MAGPIE_HTTP_TIMEOUT=20.0
MAGPIE_HTTP_RETRIES=2
# Outbound proxy for all source fetches, e.g. http://127.0.0.1:8080
MAGPIE_PROXY=
# Max post URLs/ids accepted in one batch.
MAGPIE_MAX_BATCH=25
# Parallel captures within a batch.
MAGPIE_CONCURRENCY=4
# Record TLS peer/certificate info alongside response headers.
MAGPIE_CAPTURE_TLS=1

# --- per-source User-Agent overrides ---------------------------------
# Defaults: syndication and x_page use a Chrome UA; fxtwitter and vxtwitter
# use a plain client UA.
# WARNING: MAGPIE_UA_VXTWITTER must stay a plain, non-browser UA. vxtwitter's
# Cloudflare rules return 403 for browser-like UAs without a browser
# fingerprint; that is the single cause of "vxtwitter is blocked".
MAGPIE_UA_SYNDICATION=
MAGPIE_UA_FXTWITTER=
MAGPIE_UA_VXTWITTER=
MAGPIE_UA_X_PAGE=
# Overrides every source at once (takes precedence over the four above).
MAGPIE_USER_AGENT=

# --- media -----------------------------------------------------------
# Download avatars, banners, photos and videos into <package>/media/.
MAGPIE_DOWNLOAD_MEDIA=1
# Per-asset size cap in bytes (default 128 MiB).
MAGPIE_MAX_MEDIA_BYTES=134217728
# OCR downloaded images. Silently skipped if tesseract/pytesseract is absent.
MAGPIE_OCR=1

# --- render ----------------------------------------------------------
# Render capture.pdf / capture.png with Playwright Chromium.
# Silently skipped if playwright is not installed.
MAGPIE_RENDER=1
MAGPIE_RENDER_PDF=1
MAGPIE_RENDER_PNG=1
# Explicit Chromium executable; leave empty to use Playwright's bundled build.
MAGPIE_CHROMIUM_PATH=
MAGPIE_RENDER_TIMEOUT=60.0
# Images below this size are inlined into capture.html as data URIs; larger
# files (and all video) are referenced by relative path instead.
MAGPIE_INLINE_IMAGE_BYTES=2000000

# --- evidence --------------------------------------------------------
# RFC 3161 timestamping of the manifest hash. This is the only thing that
# adds a third-party time attestation. Off by default (network dependency).
MAGPIE_TSA=0
MAGPIE_TSA_URL=https://freetsa.org/tsr
MAGPIE_TSA_TIMEOUT=20.0
# Recorded in every manifest as the person/system that took the capture.
MAGPIE_OPERATOR=

# --- HTTP API --------------------------------------------------------
# /api/v1 is gated by MAGPIE_AUTH_TOKEN for reads as well as writes.
# Collection jobs (pull/search/thread/capture) that run at once; the rest
# queue. Kept low on purpose: these share X's rate limits with the monitor.
MAGPIE_API_JOB_CONCURRENCY=2
# Seconds a finished job stays readable before it is pruned.
MAGPIE_API_JOB_TTL=3600.0
# Hard cap on retained jobs; oldest finished ones are dropped first.
MAGPIE_API_JOB_MAX=200
# Serve the Swagger UI at /api/v1/docs (the page itself pulls JS from a CDN).
MAGPIE_API_DOCS=1
